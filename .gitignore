# =========================================================================
# AccessPass Root Git Ignore
# Excludes dependencies, build outputs, environment files, certificates,
# and database dumps containing sensitive data.
# =========================================================================

# Dependencies
node_modules/
*/node_modules/

# Production Build Artifacts
dist/
*/dist/
dist-ssr/
build/
*/build/

# Environment and Secret Files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Whitelist safe example templates
!.env.example
!*/.env.example

# Private TLS / SSL Certificates, Keys, and Store Files
*.pem
*.crt
*.cer
*.key
*.pfx
*.p12

# Database Dumps and Sensitive Exports
*.sql.dump
*.dump
*.backup
backup*.sql
*dump*.sql

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System and OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.swp
*.swo

# Scratch & Temporary Testing Folders
scratch/
*/scratch/
