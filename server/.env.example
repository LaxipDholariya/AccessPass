# =========================================================================
# AccessPass Backend Environment Template
# Safe for version control. Do not put real credentials or secrets here.
# Copy to .env for local use, or configure in Render Service Settings.
# =========================================================================

# Server Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Allowed Frontend Origins for CORS (Comma-separated for multiple origins)
# Set to your exact deployed Vercel domain without trailing slash
# Production example: https://accesspass.vercel.app
# Local development: http://localhost:5173
CORS_ORIGIN=https://your-frontend-project.vercel.app

# Optional: Allow all *.vercel.app preview branches during pull request reviews
ALLOW_VERCEL_PREVIEWS=false

# =========================================================================
# Aiven / Cloud Hosted MySQL Database Configuration
# =========================================================================

# Option A: Discrete Connection Parameters (from Aiven Service Overview)
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_database_password
DB_NAME=defaultdb

# Database TLS / SSL (Mandatory for Aiven Cloud MySQL)
# Set to 'true' to enable TLS transport encryption
DB_SSL=true

# Set to 'false' if connecting without uploading a custom CA file (satisfies Aiven requirement).
# Set to 'true' if you provide DB_SSL_CA or DB_SSL_CA_PATH.
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: Provide Aiven Project CA Certificate (raw string or file path)
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_SSL_CA_PATH=./ca.pem

# Option B: Single Connection String (Alternative to discrete parameters above)
# Copied directly from "Service URI" on Aiven dashboard:
# DATABASE_URL=mysql://avnadmin:password@your-aiven-mysql-host.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Connection Pool Limit
DB_CONNECTION_LIMIT=10

# =========================================================================
# Security & Authentication
# =========================================================================
# Cryptographically strong secret key for signing JWT tokens (min 32 chars)
JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=24h
